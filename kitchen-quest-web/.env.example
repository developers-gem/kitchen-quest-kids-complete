# Optional. Defaults to "/api/v1" (a relative path), which works
# unmodified in local dev via vite.config.ts's proxy (see
# VITE_API_PROXY_TARGET below) and in production if the web app and API
# are served from the same origin behind a reverse proxy.
#
# Set this explicitly when the API lives on a different origin than the
# web app in production (e.g. a separate API subdomain):
# VITE_API_BASE_URL=https://api.kitchenquestkids.com/api/v1

# Optional, dev-server only. Where vite.config.ts's dev proxy forwards
# /api/v1/* requests to. Defaults to http://localhost:4000 (the
# backend's default PORT). Not read by the built production app at all
# -- production traffic goes directly to VITE_API_BASE_URL (or the
# same-origin default) with no proxy involved.
# VITE_API_PROXY_TARGET=http://localhost:4000
