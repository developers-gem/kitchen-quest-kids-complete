# Optional. Set this in any environment running more than one API
# instance -- without it, rate limiting silently becomes per-instance
# instead of platform-wide (see rateLimiter.js). Safe to leave unset for
# local development or a deliberate single-instance deployment.
# REDIS_URL=redis://localhost:6379

# Optional. Set this to send unexpected (non-operational) errors to
# Sentry instead of only console.error. Safe to leave unset -- errors
# still log to console either way.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
